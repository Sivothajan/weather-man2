generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model WeatherReading {
  id           Int      @id @default(autoincrement())
  temperature  Float
  humidity     Float
  soilMoisture Float
  soilRaw      Float?
  rain         Boolean
  rainRaw      Float?
  fire         Boolean
  timestamp    DateTime @default(now()) @db.Timestamp(6)

  @@index([timestamp(sort: Desc)])
}
